{
  "manifest_version": 3,
  "name": "wowdle",
  "version": "0.3.2",
  "description": "Wordle guesses, feedback, and strategy analysis.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "wowdle",
    "default_icon": {
      "16": "icons/icon16.png",
      "24": "icons/icon24.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["sidePanel", "activeTab", "scripting"],
  "host_permissions": [
    "https://www.nytimes.com/games/wordle/*",
    "https://wordleunlimited.com/*",
    "https://*.wordleunlimited.com/*",
    "https://wordleunlimited.org/*",
    "https://*.wordleunlimited.org/*",
    "http://localhost:8000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.nytimes.com/games/wordle/*",
        "https://wordleunlimited.com/*",
        "https://*.wordleunlimited.com/*",
        "https://wordleunlimited.org/*",
        "https://*.wordleunlimited.org/*",
        "http://localhost:8000/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "index.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
