{
  "manifest_version": 3,
  "name": "Wowdle Solver",
  "version": "0.2.0",
  "description": "A Wordle solver powered by the Wowdle C++ backend.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Open Wowdle Solver"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["sidePanel", "activeTab", "scripting"],
  "host_permissions": [
    "https://www.nytimes.com/games/wordle/*",
    "https://wordleunlimited.com/*",
    "https://*.wordleunlimited.com/*",
    "http://localhost:8000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.nytimes.com/games/wordle/*",
        "https://wordleunlimited.com/*",
        "https://*.wordleunlimited.com/*",
        "http://localhost:8000/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "index.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
